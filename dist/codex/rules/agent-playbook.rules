# agent-playbook (generated by tools/build.py; reinstalling replaces this file).
# Tier-2 commands (core rule 2.3): Codex asks before running them. Prefix match only;
# the agent-playbook PreToolUse hook is the main check.

prefix_rule(
    pattern = ["gh", "pr", "create"],
    decision = "prompt",
    justification = "agent-playbook rule 2.3: gh pr create is tier-2; confirm with the user first",
    match = ["gh pr create x"],
)

