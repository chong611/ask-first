{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON}",
            "args": [
              "{HOME}/.claude/agent-playbook/hooks/playbook_hook.py"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON}",
            "args": [
              "{HOME}/.claude/agent-playbook/hooks/playbook_hook.py"
            ],
            "timeout": 10
          }
        ],
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell)$|^mcp__"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON}",
            "args": [
              "{HOME}/.claude/agent-playbook/hooks/playbook_hook.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON}",
            "args": [
              "{HOME}/.claude/agent-playbook/hooks/playbook_hook.py"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON}",
            "args": [
              "{HOME}/.claude/agent-playbook/hooks/playbook_hook.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON}",
            "args": [
              "{HOME}/.claude/agent-playbook/hooks/playbook_hook.py"
            ],
            "timeout": 10
          }
        ],
        "matcher": "compact"
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(npm publish *)",
      "Bash(crontab *)",
      "mcp__github__create_pull_request",
      "mcp__github__merge_pull_request",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh repo create *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(npm publish *)",
      "PowerShell(crontab *)"
    ]
  }
}
